{
  "version": 2,
  "builds": [
    { "src": "api/tutor.js", "use": "@vercel/node", "config": { "maxDuration": 60, "includeFiles": "tutor.js" } },
    { "src": "api/people.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/tutor", "dest": "/api/tutor.js" },
    { "src": "/api/people", "dest": "/api/people.js" },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
